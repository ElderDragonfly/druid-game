{
  "name": "druid-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --mode pathways --host 0.0.0.0",
    "dev:new": "npm run dev",
    "dev:old": "vite --mode legacy --host 0.0.0.0 --port 5174",
    "editor": "vite --host 127.0.0.1 --open /editor.html",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --mode pathways",
    "build:old": "npm run typecheck && vite build --mode legacy --outDir dist-old",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/smoke.mjs",
    "test:paths": "node scripts/pathways-smoke.mjs",
    "test:editor": "node scripts/entity-editor-smoke.mjs",
    "test:camp-render": "node scripts/camp-overlay-render-smoke.mjs"
  },
  "dependencies": { "phaser": "3.90.0" },
  "devDependencies": {
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
